\f0\fs36 \cf2 \cb3 \outl0\strokewidth0 #When he was introduced he was best known for Thriller, drama and action\
\
31)Which movies made profit?\
SELECT title, budget_millions, box_office_millions,\
(budget_millions - box_office_millions) AS profit_millions\
FROM nicolas_cage_movies\
WHERE  box_office_millions >  budget_millions;\
#35 out of 58 movies from the dataset has given profit.\
\
32)ROI calculation\
SELECT title, (box_office_millions - budget_millions) /  budget_millions * 100  AS roi_percent\
FROM nicolas_cage_movies\
ORDER BY roi_percent DESC;\
\
33)How many movies per decade?\
SELECT decade, COUNT(*)  AS total_movies\
FROM nicolas_cage_movies\
GROUP BY decade\
ORDER BY decade;\

